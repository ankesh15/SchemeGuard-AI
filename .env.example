# Copy to .env and replace this placeholder before starting.
POSTGRES_USER=schemeguard
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=schemeguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
# JSON array; credentials are disabled. Use [] to disable browser access.
CORS_ORIGINS=["http://localhost:3000"]
