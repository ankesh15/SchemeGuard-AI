# Copy to .env and replace this placeholder before starting.
POSTGRES_USER=schemeguard
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=schemeguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
# Explicit fictional fixture only; permitted in development/test environments.
SEED_DEMO_DATA=true
APP_ENV=development
LOG_LEVEL=INFO
# JSON array; credentials are disabled. Use [] to disable browser access.
CORS_ORIGINS=["http://localhost:3000"]
# Optional override for tools outside Docker: postgresql+asyncpg://...
# DATABASE_URL=
# Read-only curated JSON directory inside the API container; legacy files work too.
SEED_DATA_PATH=/app/data/schemes

# Phase 3: backend-only Gemini credentials. Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=20
GEMINI_MAX_RETRIES=2
GEMINI_MAX_REQUESTS=6
GEMINI_MAX_INPUT_CHARS=20000
# Explicit same-origin admin browser hosts; HTTPS is required in production.
ADMIN_ALLOWED_ORIGINS=["http://localhost:3000"]
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_LIMIT=10
ADMIN_RATE_WINDOW_SECONDS=900
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=50
PDF_PARSE_TIMEOUT=25
PDF_MAX_TEXT_CHARS=200000
DOCUMENT_DOWNLOAD_TIMEOUT=15
CHUNK_SIZE=1800
CHUNK_OVERLAP=160
PROCESSING_TIMEOUT=90
# Docker stores originals in document_data; do not remove the volume.
# DOCUMENT_STORAGE_ROOT=/var/lib/schemeguard/documents

# Phase 4: durable LangGraph processing; no worker/queue service required.
WORKFLOW_TIMEOUT=150
WORKFLOW_MAX_ATTEMPTS=3
# Gemini embeddings are 768-dimensional and normalized before vector storage.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT=20
EMBEDDING_MAX_RETRIES=2
RAG_TOP_K=5
RAG_MAX_CHUNKS=500
RAG_MIN_SIMILARITY=0.3
# Optional model may order existing trace IDs only; templates remain authoritative.
EXPLANATION_USE_GEMINI=false
# local_hash is an explicit lexical fixture for development/testing, not semantic AI.
# It is forbidden in production. Never use it to claim live Gemini verification.

# Phase 5: Redis has no public port; PostgreSQL is the durable job outbox.
REDIS_URL=redis://redis:6379/0
WORKER_JOB_ATTEMPTS=4
WORKER_LEASE_SECONDS=600
MONITORING_DISPATCH_SECONDS=30

# Phase 6: generated privately by scripts/init_env.py; retain for decryption.
# Never commit a real key, rotate it blindly, or expose it with NEXT_PUBLIC_.
PROFILE_ENCRYPTION_KEY=
CITIZEN_SESSION_HOURS=8

# Runtime host validation; public browser requests use same-origin proxy in production.
ALLOWED_HOSTS=["localhost","127.0.0.1","test","testserver","api"]
DOCUMENT_STORAGE_BACKEND=filesystem
S3_BUCKET=
S3_REGION=ap-south-1
