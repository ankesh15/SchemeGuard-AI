{
  "id": "education",
  "version": 1,
  "basis": "project_authored_illustration",
  "title": "Education assessment",
  "description": "A project-authored category illustration. These criteria are not verified government policy and do not determine actual eligibility.",
  "categories": [
    "scholarship",
    "education"
  ],
  "program": {
    "fields": [
      {
        "key": "age_years",
        "label": "Age",
        "value_type": "number",
        "section": "Your details",
        "help_text": "Leave blank if this information is unavailable.",
        "minimum": 0,
        "maximum": 130,
        "integer": true
      },
      {
        "key": "annual_family_income_inr",
        "label": "Annual family income (INR)",
        "value_type": "number",
        "section": "Household",
        "help_text": "Leave blank if this information is unavailable.",
        "minimum": 0,
        "maximum": 1000000000000,
        "integer": false
      },
      {
        "key": "current_student",
        "label": "Currently a student?",
        "value_type": "boolean",
        "section": "Education",
        "help_text": "Leave blank if this information is unavailable."
      },
      {
        "key": "course_level",
        "label": "Education level",
        "value_type": "string",
        "section": "Education",
        "help_text": "Leave blank if this information is unavailable.",
        "choices": [
          {
            "value": "higher_secondary",
            "label": "Higher secondary"
          },
          {
            "value": "diploma",
            "label": "Diploma"
          },
          {
            "value": "undergraduate",
            "label": "Undergraduate"
          },
          {
            "value": "postgraduate",
            "label": "Postgraduate"
          },
          {
            "value": "other",
            "label": "Other"
          }
        ]
      }
    ],
    "expression": {
      "kind": "and",
      "key": "assessment",
      "label": "Overall assessment",
      "children": [
        {
          "kind": "comparison",
          "key": "minimum_age",
          "label": "Minimum assessment age",
          "field": "age_years",
          "operator": ">=",
          "value_type": "number",
          "value": 16
        },
        {
          "kind": "comparison",
          "key": "maximum_age",
          "label": "Maximum assessment age",
          "field": "age_years",
          "operator": "<=",
          "value_type": "number",
          "value": 30
        },
        {
          "kind": "comparison",
          "key": "income_limit",
          "label": "Family income range",
          "field": "annual_family_income_inr",
          "operator": "<=",
          "value_type": "number",
          "value": 500000
        },
        {
          "kind": "comparison",
          "key": "student_status",
          "label": "Current student status",
          "field": "current_student",
          "operator": "==",
          "value_type": "boolean",
          "value": true
        },
        {
          "kind": "comparison",
          "key": "study_level",
          "label": "Education pathway",
          "field": "course_level",
          "operator": "IN",
          "value_type": "string",
          "value": [
            "higher_secondary",
            "diploma",
            "undergraduate",
            "postgraduate"
          ]
        }
      ]
    }
  },
  "criteria_notes": {
    "minimum_age": "Illustrative criterion: age is at least 16.",
    "maximum_age": "Illustrative criterion: age is no more than 30.",
    "income_limit": "Illustrative criterion: annual family income is no more than INR 500,000.",
    "student_status": "Illustrative criterion: currently studying.",
    "study_level": "Illustrative criterion: higher secondary, diploma, undergraduate or postgraduate study."
  },
  "sample_profile": {
    "age_years": 21,
    "annual_family_income_inr": 240000,
    "current_student": true,
    "course_level": "undergraduate"
  }
}
