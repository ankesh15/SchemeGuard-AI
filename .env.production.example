# Copy to ignored .env.production and generate independent secrets. Never reuse owner credentials in API/worker.
POSTGRES_DB=schemeguard
POSTGRES_OWNER=schemeguard_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_USER=schemeguard_app
POSTGRES_PASSWORD=
PROFILE_ENCRYPTION_KEY=
ADMIN_ALLOWED_ORIGINS=["https://schemes.example.org"]
ALLOWED_HOSTS=["api","localhost","127.0.0.1","api.example.org"]
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
DOCUMENT_STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_PREFIX=schemeguard
S3_ENDPOINT_URL=
# Prefer a workload IAM role over static credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ALLOW_LOCAL_DOCUMENT_STORAGE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PRODUCTION_FRONTEND_PORT=13000
PRODUCTION_API_PORT=18000
